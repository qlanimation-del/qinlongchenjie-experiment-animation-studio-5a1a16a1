{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "qinlong-chenjie-mcp",
      "version": "0.1.0",
      "title": "QinLong & ChenJie Studio"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List all works by QinLong & ChenJie studio (animations, video essays, short films, commercials). Optionally filter by year or type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "year": {
              "description": "Filter by year, e.g. '2023' or '2023-2024'.",
              "type": "string"
            },
            "type": {
              "description": "Filter by type, e.g. 'Short Film', 'Video essay', 'Commercial', 'Independent Animation'.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Get project",
        "description": "Get full details for a single project by its id. Use list_projects first to discover valid ids.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "The project id, e.g. 'between-us' or 'entering-cloud'."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_studio_info",
        "title": "Get studio info",
        "description": "Get information about the QinLong & ChenJie experimental animation studio — directors, location, focus, and contact URLs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
